# Cubo unitário centrado na origem; corpo provisório do Player.
# Topologia baseada no cubo da referência cg-project3d-uece.
mtllib cube.mtl
o PlayerPlaceholder
v -0.5 -0.5 -0.5
v 0.5 -0.5 -0.5
v 0.5 0.5 -0.5
v -0.5 0.5 -0.5
v -0.5 -0.5 0.5
v 0.5 -0.5 0.5
v 0.5 0.5 0.5
v -0.5 0.5 0.5
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 -1 0
vn 0 1 0
usemtl PlayerRed
s off
f 2//1 1//1 4//1 3//1
f 5//2 6//2 7//2 8//2
f 1//3 5//3 8//3 4//3
f 6//4 2//4 3//4 7//4
f 1//5 2//5 6//5 5//5
f 8//6 7//6 3//6 4//6
